# Server Configuration
PORT=3000
NODE_ENV=production

# AI / Vision Engine Key (Optional - will run in mock mode if unset)
GEMINI_API_KEY=

# Security & API Protection
MASTER_API_KEY=satquery-demo-secret
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=50

# Client Base URL (Leave blank for relative same-origin calls)
VITE_API_BASE_URL=
VITE_API_KEY=satquery-demo-secret